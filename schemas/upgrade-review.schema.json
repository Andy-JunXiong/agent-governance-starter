{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/upgrade-review.schema.json",
  "title": "AgentGov Consumer Upgrade Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool",
    "mode",
    "consumer",
    "release",
    "transition",
    "consumer_findings",
    "review_state",
    "gates",
    "human_decision",
    "limitations",
    "authority_boundary"
  ],
  "properties": {
    "contract_version": {"const": "1.1"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agentgov"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "mode": {"const": "consumer_local_review"},
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "artifact_filename", "artifact_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "channel": {"enum": ["release-candidate", "stable"]},
        "artifact_filename": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_version", "available_version", "plan_state", "changes"],
      "properties": {
        "current_version": {"type": "string", "minLength": 1},
        "available_version": {"type": "string", "minLength": 1},
        "plan_state": {"enum": ["current", "candidate", "blocked"]},
        "changes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before_sha256", "after_sha256"],
            "properties": {
              "path": {
                "enum": [
                  ".github/workflows/agentgov.yml",
                  ".github/workflows/agentgov-upgrade.yml"
                ]
              },
              "action": {"enum": ["create", "update"]},
              "before_sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "allOf": [
              {
                "if": {"properties": {"action": {"const": "create"}}},
                "then": {"properties": {"before_sha256": {"type": "null"}}},
                "else": {"properties": {"before_sha256": {"type": "string"}}}
              }
            ]
          }
        }
      }
    },
    "consumer_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "advisory"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0}
      }
    },
    "review_state": {
      "enum": ["ready_for_human_review", "no_upgrade_needed", "blocked"]
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "allowed"],
      "properties": {
        "state": {"const": "pending"},
        "allowed": {"const": ["approve", "request_changes", "reject"]}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_output_created",
        "governed_files_modified",
        "planned_change_applied",
        "git_branch_created",
        "pull_request_created",
        "merge_authorized",
        "release_or_deploy_authorized"
      ],
      "properties": {
        "review_output_created": {"const": true},
        "governed_files_modified": {"const": false},
        "planned_change_applied": {"const": false},
        "git_branch_created": {"const": false},
        "pull_request_created": {"const": false},
        "merge_authorized": {"const": false},
        "release_or_deploy_authorized": {"const": false}
      }
    }
  }
}
