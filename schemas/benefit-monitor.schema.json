{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/benefit-monitor.schema.json",
  "title": "AgentGov Continuous Benefit Monitor",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tool", "mode", "state", "user_state", "snapshot", "baseline", "comparison", "history", "scope_limitations", "authority_boundary"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "tool": {"$ref": "#/$defs/tool"},
    "mode": {"const": "observational_read_only"},
    "state": {"enum": ["baseline_missing", "unchanged", "improvement_observed", "regression_observed", "mixed_change", "change_observed"]},
    "user_state": {"enum": ["missing", "unchanged", "improved", "needs_review"]},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "snapshot", "reason"],
      "properties": {
        "available": {"type": "boolean"},
        "snapshot": {"anyOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "comparison": {"anyOf": [{"$ref": "#/$defs/comparison"}, {"type": "null"}]},
    "history": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/history_point"}},
    "scope_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governed_repository_modified", "git_or_pull_request_action_run", "merge_release_or_deploy_authorized"],
      "properties": {
        "governed_repository_modified": {"const": false},
        "git_or_pull_request_action_run": {"const": false},
        "merge_release_or_deploy_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "agentgov"}, "version": {"type": "string", "minLength": 1}}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "advisory"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit_sha", "run_id", "run_attempt", "event", "observed_at", "report_sha256", "tool_version", "summary"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "event": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_version": {"type": "string", "minLength": 1},
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "check_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominators", "deterministic_failures_resolved", "deterministic_failures_introduced", "non_passing_findings_cleared", "added_checks", "removed_checks", "transitions"],
      "properties": {
        "denominators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_finding_count", "after_finding_count", "matched_check_count"],
          "properties": {
            "before_finding_count": {"type": "integer", "minimum": 0},
            "after_finding_count": {"type": "integer", "minimum": 0},
            "matched_check_count": {"type": "integer", "minimum": 0}
          }
        },
        "deterministic_failures_resolved": {"$ref": "#/$defs/check_ids"},
        "deterministic_failures_introduced": {"$ref": "#/$defs/check_ids"},
        "non_passing_findings_cleared": {"$ref": "#/$defs/check_ids"},
        "added_checks": {"$ref": "#/$defs/check_ids"},
        "removed_checks": {"$ref": "#/$defs/check_ids"},
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "before", "after"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "before": {"enum": ["PASS", "WARN", "FAIL", "ADVISORY"]},
              "after": {"enum": ["PASS", "WARN", "FAIL", "ADVISORY"]}
            }
          }
        }
      }
    },
    "history_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "observed_at", "commit_sha", "state", "summary"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "state": {"enum": ["baseline_missing", "unchanged", "improvement_observed", "regression_observed", "mixed_change", "change_observed"]},
        "summary": {"$ref": "#/$defs/summary"}
      }
    }
  }
}
