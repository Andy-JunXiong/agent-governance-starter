{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/development-scope-report-v1.json",
  "title": "AgentGov Development Scope Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "task_id",
    "task_path",
    "task_digest",
    "head_sha",
    "changes",
    "findings",
    "known_limits",
    "authority_boundary"
  ],
  "properties": {
    "contract": {"const": "agentgov.development-scope-report"},
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_path": {"type": "string", "minLength": 1},
    "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "status", "path", "old_path", "endpoints"],
        "properties": {
          "layer": {"enum": ["staged", "unstaged", "untracked"]},
          "status": {"enum": ["added", "copied", "deleted", "modified", "renamed", "type_changed", "unmerged", "unknown", "untracked"]},
          "path": {"type": "string", "minLength": 1},
          "old_path": {"type": ["string", "null"]},
          "endpoints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "path", "admitted", "matched_include", "matched_exclude", "reason"],
              "properties": {
                "role": {"enum": ["current", "old", "new"]},
                "path": {"type": "string", "minLength": 1},
                "admitted": {"type": "boolean"},
                "matched_include": {"type": ["string", "null"]},
                "matched_exclude": {"type": ["string", "null"]},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "check_id", "message"],
        "properties": {
          "status": {"enum": ["PASS", "FAIL", "ADVISORY"]},
          "check_id": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes_repository",
        "modifies_worktree",
        "modifies_index",
        "modifies_branch",
        "modifies_history",
        "authorizes_exception",
        "authorizes_commit",
        "authorizes_merge"
      ],
      "properties": {
        "writes_repository": {"const": false},
        "modifies_worktree": {"const": false},
        "modifies_index": {"const": false},
        "modifies_branch": {"const": false},
        "modifies_history": {"const": false},
        "authorizes_exception": {"const": false},
        "authorizes_commit": {"const": false},
        "authorizes_merge": {"const": false}
      }
    }
  }
}
