{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/documentation-archive-plan.schema.json",
  "title": "AgentGov Documentation Archive Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "tool",
    "repository",
    "through_date",
    "mode",
    "state",
    "source_directory",
    "eligibility",
    "entries",
    "change",
    "findings",
    "authority_boundary"
  ],
  "properties": {
    "contract": {"const": "agentgov.documentation-archive-plan"},
    "schema_version": {"const": "1.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agentgov"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "repository": {"type": "string", "minLength": 1},
    "through_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "mode": {"const": "read_only"},
    "state": {"enum": ["pass", "warn", "fail", "not_applicable"]},
    "source_directory": {"const": "docs/development-log"},
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "filename_pattern",
        "includes_on_or_before",
        "preserves_source_paths",
        "uses_host_clock"
      ],
      "properties": {
        "kind": {"const": "logical_index_inclusion"},
        "filename_pattern": {"type": "string", "minLength": 1},
        "includes_on_or_before": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "preserves_source_paths": {"const": true},
        "uses_host_clock": {"const": false}
      }
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "date", "title", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/development-log/[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-[a-z0-9][a-z0-9-]*)?\\.md$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "title": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "change": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "action", "before_sha256", "after_sha256", "content"],
      "properties": {
        "path": {"const": "docs/development-log/INDEX.md"},
        "action": {"enum": ["create", "update", "none"]},
        "before_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "create"}}},
          "then": {"properties": {"before_sha256": {"type": "null"}}},
          "else": {"properties": {"before_sha256": {"type": "string"}}}
        }
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "semantics", "code", "path", "message"],
        "properties": {
          "status": {"enum": ["pass", "warn", "fail", "advisory", "not_applicable"]},
          "semantics": {"enum": ["deterministic", "advisory"]},
          "code": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "path": {"type": ["string", "null"]},
          "message": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"semantics": {"const": "advisory"}}},
            "then": {"properties": {"status": {"const": "advisory"}}},
            "else": {
              "properties": {
                "status": {"enum": ["pass", "warn", "fail", "not_applicable"]}
              }
            }
          }
        ]
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_modified",
        "index_written",
        "source_log_moved",
        "source_log_renamed",
        "source_log_deleted",
        "apply_authorized",
        "scheduling_authorized",
        "git_operation_authorized",
        "publication_authorized",
        "release_authorized",
        "deployment_authorized"
      ],
      "properties": {
        "repository_modified": {"const": false},
        "index_written": {"const": false},
        "source_log_moved": {"const": false},
        "source_log_renamed": {"const": false},
        "source_log_deleted": {"const": false},
        "apply_authorized": {"const": false},
        "scheduling_authorized": {"const": false},
        "git_operation_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "release_authorized": {"const": false},
        "deployment_authorized": {"const": false}
      }
    }
  }
}
