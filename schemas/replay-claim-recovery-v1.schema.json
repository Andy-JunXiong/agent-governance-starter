{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/replay-claim-recovery-v1.0.json",
  "title": "AgentGov replay claim recovery contracts",
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/inspection"},
    {"$ref": "#/$defs/marker"},
    {"$ref": "#/$defs/preview"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizes_cleanup",
        "authorizes_deployment",
        "authorizes_git_operations",
        "authorizes_publication",
        "authorizes_release",
        "authorizes_replay",
        "authorizes_repository_write",
        "authorizes_task_admission"
      ],
      "properties": {
        "authorizes_cleanup": {"const": false},
        "authorizes_deployment": {"const": false},
        "authorizes_git_operations": {"const": false},
        "authorizes_publication": {"const": false},
        "authorizes_release": {"const": false},
        "authorizes_replay": {"const": false},
        "authorizes_repository_write": {"const": false},
        "authorizes_task_admission": {"const": false}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "normalizedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^rpf-[0-9a-f]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "protocol_version"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/normalizedId"},
        "adapter_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:(?:a|b|rc)[0-9]+)?$"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "correlation_id",
        "reservation",
        "claim",
        "recovery",
        "adapter",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-claim-recovery-plan"},
        "schema_version": {"const": "1.0"},
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marker_path", "marker_digest"],
          "properties": {
            "marker_path": {"$ref": "#/$defs/relativePath"},
            "marker_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marker_path"],
          "properties": {
            "marker_path": {"$ref": "#/$defs/relativePath"}
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_directory", "recovered_by", "reason_code"],
          "properties": {
            "registry_directory": {"$ref": "#/$defs/relativePath"},
            "recovered_by": {"$ref": "#/$defs/normalizedId"},
            "reason_code": {"$ref": "#/$defs/normalizedId"}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata_path"],
          "properties": {
            "metadata_path": {"$ref": "#/$defs/relativePath"}
          }
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "reservationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservation_id", "marker_path", "marker_digest"],
      "properties": {
        "reservation_id": {
          "type": "string",
          "pattern": "^rrv-[0-9a-f]{16}$"
        },
        "marker_path": {"$ref": "#/$defs/relativePath"},
        "marker_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "abandonedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_path", "marker_digest", "byte_length", "classification"],
      "properties": {
        "marker_path": {"$ref": "#/$defs/relativePath"},
        "marker_digest": {"$ref": "#/$defs/sha256"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "classification": {"enum": ["VALID", "PARTIAL", "MALFORMED"]}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "recovery_id",
        "correlation_id",
        "recovery_path",
        "reservation",
        "abandoned_claim",
        "repository_head",
        "adapter",
        "recovered_by",
        "reason_code",
        "status",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-claim-recovery"},
        "schema_version": {"const": "1.0"},
        "recovery_id": {
          "type": "string",
          "pattern": "^rcr-[0-9a-f]{16}$"
        },
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "recovery_path": {"$ref": "#/$defs/relativePath"},
        "reservation": {"$ref": "#/$defs/reservationBinding"},
        "abandoned_claim": {"$ref": "#/$defs/abandonedClaim"},
        "repository_head": {"$ref": "#/$defs/gitSha"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "recovered_by": {"$ref": "#/$defs/normalizedId"},
        "reason_code": {"$ref": "#/$defs/normalizedId"},
        "status": {"const": "recovered"},
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "check_id", "reason_code", "message"],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
        "check_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "reason_code": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 120}
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "classification",
        "correlation_id",
        "claim_path",
        "observed_claim_digest",
        "observed_byte_length",
        "recovery_path",
        "findings",
        "reason_codes",
        "known_limits",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-claim-recovery-inspection"},
        "schema_version": {"const": "1.0"},
        "classification": {
          "enum": ["VALID", "PARTIAL", "MALFORMED", "MISSING", "INCONSISTENT", "UNKNOWN", "RECOVERED"]
        },
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "claim_path": {"$ref": "#/$defs/relativePath"},
        "observed_claim_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "observed_byte_length": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 1048576}
          ]
        },
        "recovery_path": {"$ref": "#/$defs/relativePath"},
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/finding"}
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "status", "inspection", "recovery", "authority_boundary"],
      "properties": {
        "contract": {"const": "agentgov.replay-claim-recovery-preview"},
        "schema_version": {"const": "1.0"},
        "status": {"enum": ["READY_TO_RECOVER", "BLOCKED", "UNKNOWN", "ALREADY_RECOVERED"]},
        "inspection": {"$ref": "#/$defs/inspection"},
        "recovery": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/marker"}]
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "READY_TO_RECOVER"}}},
          "then": {"properties": {"recovery": {"$ref": "#/$defs/marker"}}},
          "else": {"properties": {"recovery": {"type": "null"}}}
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "status",
        "correlation_id",
        "recovery_path",
        "recovery_digest",
        "effect",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-claim-recovery-result"},
        "schema_version": {"const": "1.0"},
        "status": {"const": "RECOVERED"},
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "recovery_path": {"$ref": "#/$defs/relativePath"},
        "recovery_digest": {"$ref": "#/$defs/sha256"},
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_modified", "recovery_created"],
          "properties": {
            "repository_modified": {"const": true},
            "recovery_created": {"const": true}
          }
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    }
  }
}
