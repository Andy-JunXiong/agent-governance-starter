{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/replay-correlation-claim-v1.0.json",
  "title": "AgentGov replay correlation claim contracts",
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/marker"},
    {"$ref": "#/$defs/preview"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizes_cleanup",
        "authorizes_deployment",
        "authorizes_git_operations",
        "authorizes_publication",
        "authorizes_release",
        "authorizes_replay",
        "authorizes_repository_write",
        "authorizes_task_admission"
      ],
      "properties": {
        "authorizes_cleanup": {"const": false},
        "authorizes_deployment": {"const": false},
        "authorizes_git_operations": {"const": false},
        "authorizes_publication": {"const": false},
        "authorizes_release": {"const": false},
        "authorizes_replay": {"const": false},
        "authorizes_repository_write": {"const": false},
        "authorizes_task_admission": {"const": false}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^rpf-[0-9a-f]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "normalizedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "protocol_version"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/normalizedId"},
        "adapter_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:(?:a|b|rc)[0-9]+)?$"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "reservation",
        "claim",
        "adapter",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-correlation-claim-plan"},
        "schema_version": {"const": "1.0"},
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marker_path", "marker_digest"],
          "properties": {
            "marker_path": {"$ref": "#/$defs/relativePath"},
            "marker_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_directory", "claimant_id"],
          "properties": {
            "registry_directory": {"$ref": "#/$defs/relativePath"},
            "claimant_id": {"$ref": "#/$defs/normalizedId"}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata_path"],
          "properties": {
            "metadata_path": {"$ref": "#/$defs/relativePath"}
          }
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "claim_id",
        "correlation_id",
        "claim_path",
        "reservation",
        "repository_head",
        "adapter",
        "claimant_id",
        "status",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-correlation-claim"},
        "schema_version": {"const": "1.0"},
        "claim_id": {
          "type": "string",
          "pattern": "^rcl-[0-9a-f]{16}$"
        },
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "claim_path": {"$ref": "#/$defs/relativePath"},
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reservation_id", "marker_path", "marker_digest"],
          "properties": {
            "reservation_id": {
              "type": "string",
              "pattern": "^rrv-[0-9a-f]{16}$"
            },
            "marker_path": {"$ref": "#/$defs/relativePath"},
            "marker_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "repository_head": {"$ref": "#/$defs/gitSha"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "claimant_id": {"$ref": "#/$defs/normalizedId"},
        "status": {"const": "claimed"},
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "check_id", "reason_code", "message"],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
        "check_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "reason_code": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 120}
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "status",
        "correlation_id",
        "claim_path",
        "claim",
        "reservation_marker_digest",
        "findings",
        "reason_codes",
        "known_limits",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-correlation-claim-preview"},
        "schema_version": {"const": "1.0"},
        "status": {"enum": ["READY_TO_CLAIM", "BLOCKED", "UNKNOWN"]},
        "correlation_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/correlationId"}]
        },
        "claim_path": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/relativePath"}]
        },
        "claim": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/marker"}]
        },
        "reservation_marker_digest": {"$ref": "#/$defs/sha256"},
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/finding"}
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "READY_TO_CLAIM"}}},
          "then": {"properties": {"claim": {"$ref": "#/$defs/marker"}}},
          "else": {"properties": {"claim": {"type": "null"}}}
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "status",
        "correlation_id",
        "claim_path",
        "claim_digest",
        "effect",
        "authority_boundary"
      ],
      "properties": {
        "contract": {"const": "agentgov.replay-correlation-claim-result"},
        "schema_version": {"const": "1.0"},
        "status": {"const": "CLAIMED"},
        "correlation_id": {"$ref": "#/$defs/correlationId"},
        "claim_path": {"$ref": "#/$defs/relativePath"},
        "claim_digest": {"$ref": "#/$defs/sha256"},
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_modified", "claim_created"],
          "properties": {
            "repository_modified": {"const": true},
            "claim_created": {"const": true}
          }
        },
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    }
  }
}
