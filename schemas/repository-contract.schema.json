{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/repository-contract.schema.json",
  "title": "AgentGov Repository Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "layout_version"],
  "properties": {
    "contract": {"const": "agentgov.repository-contract"},
    "schema_version": {"const": "1.0"},
    "layout_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  }
}
