{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Governance Repository Report",
  "description": "Versioned integration contract for one deterministic repository governance check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "repository",
    "summary",
    "findings",
    "known_gaps",
    "recommended_actions",
    "scope_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agentgov"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "known_gaps": {
      "type": "array",
      "description": "The non-PASS subset of findings, preserved in finding order.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommended_action"
      }
    },
    "scope_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "ADVISORY"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "warn",
        "fail",
        "advisory"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "advisory": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "recommended_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "action"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "WARN",
            "FAIL",
            "ADVISORY"
          ]
        },
        "action": {
          "type": "string"
        }
      }
    }
  }
}
