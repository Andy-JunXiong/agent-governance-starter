{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/task-admission-plan-v1.0.json",
  "title": "AgentGov Task Admission Plan",
  "description": "A read-only preview of the exact low-risk task that may be created after explicit human admission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "proposal", "proposal_digest", "action", "target", "task_document", "task_digest", "targets", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.task-admission-plan"},
    "schema_version": {"const": "1.0"},
    "proposal": {"$ref": "task-proposal.schema.json"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "action": {"const": "create"},
    "target": {"type": "string", "pattern": "^governance/tasks/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"},
    "task_document": {"$ref": "development-task.schema.json"},
    "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targets": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_modified", "task_admitted", "session_started", "authorizes_code_change", "authorizes_scope_expansion", "authorizes_exception", "authorizes_git_operations", "authorizes_deployment", "authorizes_release"],
      "properties": {
        "repository_modified": {"const": false},
        "task_admitted": {"const": false},
        "session_started": {"const": false},
        "authorizes_code_change": {"const": false},
        "authorizes_scope_expansion": {"const": false},
        "authorizes_exception": {"const": false},
        "authorizes_git_operations": {"const": false},
        "authorizes_deployment": {"const": false},
        "authorizes_release": {"const": false}
      }
    }
  }
}
