{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/admission-route-v1.0.json",
  "title": "AgentGov Admission Route",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "policy", "request", "route", "reason_codes", "friction", "task_plan", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.admission-route"},
    "schema_version": {"const": "1.0"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["path", "policy_id", "policy_digest", "state", "tracked_clean"], "properties": {"path": {"type": "string", "minLength": 1}, "policy_id": {"type": "string", "minLength": 1}, "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "state": {"enum": ["draft", "admitted", "paused"]}, "tracked_clean": {"type": "boolean"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "request_digest", "request_class"], "properties": {"request_id": {"type": "string", "pattern": "^wrq-[0-9a-f]{32}$"}, "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "request_class": {"type": "string"}}},
    "route": {"enum": ["observe_only", "continue_active", "fast_track", "human_review", "full_review"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "friction": {"type": "object", "additionalProperties": false, "required": ["planned_human_interruptions", "max_human_interruptions", "within_budget"], "properties": {"planned_human_interruptions": {"type": "integer", "minimum": 0, "maximum": 2}, "max_human_interruptions": {"type": "integer", "minimum": 0, "maximum": 2}, "within_budget": {"const": true}}},
    "task_plan": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["target", "task_id", "task_digest"], "properties": {"target": {"type": "string", "pattern": "^governance/tasks/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"}, "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}]},
    "authority_boundary": {"type": "object", "additionalProperties": false, "required": ["standing_policy_authorizes_task_admission", "decision_applied", "repository_modified", "task_admitted", "session_started", "authorizes_code_change", "authorizes_scope_expansion", "authorizes_exception", "authorizes_git_operations", "authorizes_deployment", "authorizes_release"], "properties": {"standing_policy_authorizes_task_admission": {"type": "boolean"}, "decision_applied": {"type": "boolean"}, "repository_modified": {"type": "boolean"}, "task_admitted": {"type": "boolean"}, "session_started": {"const": false}, "authorizes_code_change": {"const": false}, "authorizes_scope_expansion": {"const": false}, "authorizes_exception": {"const": false}, "authorizes_git_operations": {"const": false}, "authorizes_deployment": {"const": false}, "authorizes_release": {"const": false}}}
  }
}
