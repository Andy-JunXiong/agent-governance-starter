{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/development-event-export-v1.0.json",
  "title": "AgentGov Redacted Development Event Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "export_id", "created_at", "source", "redaction", "events", "claim_limits", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.development-event-export"},
    "schema_version": {"const": "1.0"},
    "export_id": {"type": "string", "pattern": "^exp-[0-9a-f]{32}$"},
    "created_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_scope", "event_files_read", "duplicates_removed", "event_count", "started_at", "ended_at", "events_digest"],
      "properties": {
        "observation_scope": {"const": "local_session"},
        "event_files_read": {"$ref": "#/$defs/count"},
        "duplicates_removed": {"$ref": "#/$defs/count"},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "started_at": {"type": "string", "minLength": 1},
        "ended_at": {"type": "string", "minLength": 1},
        "events_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "actor_labels_removed", "evidence_refs_removed", "source_content_included", "validation_output_included", "absolute_paths_included", "credentials_included"],
      "properties": {
        "profile": {"const": "metadata_only_v1"},
        "actor_labels_removed": {"$ref": "#/$defs/count"},
        "evidence_refs_removed": {"$ref": "#/$defs/count"},
        "source_content_included": {"const": false},
        "validation_output_included": {"const": false},
        "absolute_paths_included": {"const": false},
        "credentials_included": {"const": false}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/redactedEvent"}
    },
    "claim_limits": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approves_governance", "writes_governance_files", "authorizes_exception", "authorizes_commit", "authorizes_merge", "authorizes_deployment"],
      "properties": {
        "approves_governance": {"const": false},
        "writes_governance_files": {"const": false},
        "authorizes_exception": {"const": false},
        "authorizes_commit": {"const": false},
        "authorizes_merge": {"const": false},
        "authorizes_deployment": {"const": false}
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\).+$"},
    "redactedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "event_id", "occurred_at", "event_type", "actor", "task_id", "task_digest", "observation_scope", "outcome", "evidence_ref", "governance_refs", "reason_codes", "metrics", "authority_boundary"],
      "properties": {
        "contract": {"const": "agentgov.governance-event"},
        "schema_version": {"const": "1.2"},
        "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
        "occurred_at": {"type": "string", "minLength": 1},
        "event_type": {"enum": ["task.started", "scope.checked", "validation.completed", "completion.reconciled", "session.handed_off"]},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "properties": {"class": {"enum": ["human", "coding_agent"]}}
        },
        "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "observation_scope": {"const": "local_development"},
        "outcome": {"enum": ["started", "passed", "failed", "stale", "needs_evidence", "verified", "handed_off"]},
        "evidence_ref": {"const": null},
        "governance_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "reason_codes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "metrics": {"type": "object", "maxProperties": 64, "propertyNames": {"maxLength": 64}, "additionalProperties": {"$ref": "#/$defs/count"}},
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizes_code_change", "authorizes_exception", "authorizes_commit", "authorizes_merge", "authorizes_deployment"],
          "properties": {
            "authorizes_code_change": {"const": false},
            "authorizes_exception": {"const": false},
            "authorizes_commit": {"const": false},
            "authorizes_merge": {"const": false},
            "authorizes_deployment": {"const": false}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"event_type": {"const": "session.handed_off"}}, "required": ["event_type"]},
          "then": {
            "properties": {
              "outcome": {"const": "handed_off"},
              "actor": {"properties": {"class": {"const": "human"}}}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "handed_off"}}, "required": ["outcome"]},
          "then": {"properties": {"event_type": {"const": "session.handed_off"}}}
        }
      ]
    }
  }
}
