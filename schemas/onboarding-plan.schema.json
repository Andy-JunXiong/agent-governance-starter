{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/onboarding-plan.schema.json",
  "title": "Agent Governance Onboarding Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository",
    "mode",
    "interaction",
    "project_name",
    "diagnosis",
    "plan",
    "next_action",
    "authority_boundary"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "repository": { "type": "string", "minLength": 1 },
    "mode": { "const": "dry_run" },
    "interaction": { "enum": ["no_prompt", "non_interactive"] },
    "project_name": { "type": "string", "minLength": 1 },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings"],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PASS", "WARN", "FAIL", "ADVISORY"],
          "properties": {
            "PASS": { "type": "integer", "minimum": 0 },
            "WARN": { "type": "integer", "minimum": 0 },
            "FAIL": { "type": "integer", "minimum": 0 },
            "ADVISORY": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "check_id", "message", "classification"],
            "properties": {
              "status": { "enum": ["PASS", "WARN", "FAIL", "ADVISORY"] },
              "check_id": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "classification": { "enum": ["deterministic", "advisory"] }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "preserve"],
      "properties": {
        "create": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "preserve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modifies_repository",
        "write_authorized",
        "repairs_project_environment",
        "installs_project_dependencies",
        "authorizes_git_or_release_operations"
      ],
      "properties": {
        "modifies_repository": { "const": false },
        "write_authorized": { "const": false },
        "repairs_project_environment": { "const": false },
        "installs_project_dependencies": { "const": false },
        "authorizes_git_or_release_operations": { "const": false }
      }
    }
  }
}
