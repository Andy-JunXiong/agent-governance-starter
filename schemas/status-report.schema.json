{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/status-report.schema.json",
  "title": "AgentGov Repository Usage Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool",
    "repository",
    "mode",
    "interaction",
    "adoption",
    "ci",
    "capabilities",
    "surfaces",
    "summary",
    "next_action",
    "authority_boundary"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agentgov"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "repository": {"type": "string", "minLength": 1},
    "mode": {"const": "read_only"},
    "interaction": {"enum": ["no_prompt", "non_interactive"]},
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "layout_version", "layout_error"],
      "properties": {
        "configured": {"type": "boolean"},
        "layout_version": {"type": ["string", "null"]},
        "layout_error": {"type": ["string", "null"]}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "managed_path", "workflow_paths", "message"],
      "properties": {
        "state": {"enum": ["managed", "custom", "missing", "conflict"]},
        "managed_path": {"const": ".github/workflows/agentgov.yml"},
        "workflow_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "message": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "owner",
          "risk_level",
          "readiness",
          "manifest",
          "called_by"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "risk_level": {"type": "string", "minLength": 1},
          "readiness": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "minLength": 1},
          "called_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "explanation"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "WARN", "FAIL", "ADVISORY"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "WARN": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "ADVISORY": {"type": "integer", "minimum": 0}
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "command", "blocking"],
      "properties": {
        "kind": {
          "enum": [
            "deterministic_work",
            "incomplete_evidence",
            "human_judgment",
            "complete"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "command": {"type": ["string", "null"]},
        "blocking": {"type": "boolean"}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modifies_repository",
        "runs_project_or_production_workflows",
        "authorizes_git_or_release_operations"
      ],
      "properties": {
        "modifies_repository": {"const": false},
        "runs_project_or_production_workflows": {"const": false},
        "authorizes_git_or_release_operations": {"const": false}
      }
    }
  }
}
