{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/codex-hooks-integration-plan-v1.0.json",
  "title": "AgentGov Codex Hooks Integration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "repository", "mode", "interaction", "item", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.codex-hooks-integration-plan"},
    "schema_version": {"const": "1.0"},
    "repository": {"type": "string", "minLength": 1},
    "mode": {"const": "dry_run"},
    "interaction": {"enum": ["no_prompt", "non_interactive"]},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path", "reason", "content"],
      "properties": {
        "action": {"enum": ["CREATE", "PRESERVE", "CONFLICT"]},
        "path": {"const": ".codex/hooks.json"},
        "reason": {"type": "string", "minLength": 1},
        "content": {"type": ["string", "null"]}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_modified", "write_authorized", "hook_trust_authorized", "installs_plugin", "authorizes_git_or_release_operations"],
      "properties": {
        "repository_modified": {"const": false},
        "write_authorized": {"const": false},
        "hook_trust_authorized": {"const": false},
        "installs_plugin": {"const": false},
        "authorizes_git_or_release_operations": {"const": false}
      }
    }
  }
}
