{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/upgrade-observation.schema.json",
  "title": "AgentGov Upgrade Automation Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tool", "mode", "repository", "commit_sha", "run_id", "upgrade_state", "branch", "pull_request_url", "metrics", "metric_definitions", "scope_limitations", "authority_boundary"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "agentgov"}, "version": {"type": "string", "minLength": 1}}
    },
    "mode": {"const": "observational_read_only"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "integer", "minimum": 1},
    "upgrade_state": {"enum": ["current", "created", "recovered", "existing"]},
    "branch": {"type": ["string", "null"]},
    "pull_request_url": {"type": ["string", "null"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_pr_created_this_run", "detection_to_draft_pr_seconds", "mechanical_bridge_actions_observed", "human_merge_decision_required"],
      "properties": {
        "draft_pr_created_this_run": {"type": "boolean"},
        "detection_to_draft_pr_seconds": {"type": ["integer", "null"], "minimum": 0},
        "mechanical_bridge_actions_observed": {"enum": [0, null]},
        "human_merge_decision_required": {"type": "boolean"}
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_to_draft_pr_seconds", "mechanical_bridge_actions_observed"],
      "properties": {
        "detection_to_draft_pr_seconds": {"type": "string", "minLength": 1},
        "mechanical_bridge_actions_observed": {"type": "string", "minLength": 1}
      }
    },
    "scope_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_authorized", "release_or_deploy_authorized"],
      "properties": {"merge_authorized": {"const": false}, "release_or_deploy_authorized": {"const": false}}
    }
  }
}
