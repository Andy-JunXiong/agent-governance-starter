{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/doctor-report.schema.json",
  "title": "Agent Governance Doctor Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool",
    "repository",
    "mode",
    "interaction",
    "runtime",
    "summary",
    "findings",
    "authority_boundary"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "agentgov" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "repository": { "type": "string", "minLength": 1 },
    "mode": { "const": "read_only" },
    "interaction": { "enum": ["no_prompt", "non_interactive"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_executable", "python_version"],
      "properties": {
        "python_executable": { "type": "string", "minLength": 1 },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "WARN", "FAIL", "ADVISORY"],
      "properties": {
        "PASS": { "type": "integer", "minimum": 0 },
        "WARN": { "type": "integer", "minimum": 0 },
        "FAIL": { "type": "integer", "minimum": 0 },
        "ADVISORY": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "check_id", "message", "classification"],
        "properties": {
          "status": { "enum": ["PASS", "WARN", "FAIL", "ADVISORY"] },
          "check_id": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["deterministic", "advisory"] }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modifies_repository",
        "repairs_project_environment",
        "installs_project_dependencies",
        "authorizes_git_or_release_operations"
      ],
      "properties": {
        "modifies_repository": { "const": false },
        "repairs_project_environment": { "const": false },
        "installs_project_dependencies": { "const": false },
        "authorizes_git_or_release_operations": { "const": false }
      }
    }
  }
}
