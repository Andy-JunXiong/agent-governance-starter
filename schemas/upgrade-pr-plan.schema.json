{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-governance-starter/upgrade-pr-plan.schema.json",
  "title": "AgentGov Upgrade Pull Request Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool",
    "repository",
    "manifest_source",
    "mode",
    "state",
    "current_version",
    "available_version",
    "pull_request",
    "reasons",
    "authority_boundary"
  ],
  "properties": {
    "contract_version": {"const": "1.1"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agentgov"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "repository": {"type": "string", "minLength": 1},
    "manifest_source": {"type": "string", "minLength": 1},
    "mode": {"const": "read_only"},
    "state": {"enum": ["current", "candidate", "blocked"]},
    "current_version": {"type": "string", "minLength": 1},
    "available_version": {"type": "string", "minLength": 1},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "title", "body", "changes"],
      "properties": {
        "branch": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "body": {"type": ["string", "null"]},
        "changes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before_sha256", "after_sha256", "content"],
            "properties": {
              "path": {
                "enum": [
                  ".github/workflows/agentgov.yml",
                  ".github/workflows/agentgov-upgrade.yml"
                ]
              },
              "action": {"enum": ["create", "update"]},
              "before_sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "content": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"action": {"const": "create"}}},
                "then": {"properties": {"before_sha256": {"type": "null"}}},
                "else": {"properties": {"before_sha256": {"type": "string"}}}
              }
            ]
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_modified",
        "git_branch_created",
        "pull_request_created",
        "merge_authorized",
        "release_or_deploy_authorized"
      ],
      "properties": {
        "repository_modified": {"const": false},
        "git_branch_created": {"const": false},
        "pull_request_created": {"const": false},
        "merge_authorized": {"const": false},
        "release_or_deploy_authorized": {"const": false}
      }
    }
  }
}
