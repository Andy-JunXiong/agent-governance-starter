{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/human-decision-result-v1.0.json",
  "title": "AgentGov Human Decision Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "result_id", "prompt", "source", "selection", "actor", "recorded_at", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.human-decision-result"},
    "schema_version": {"const": "1.0"},
    "result_id": {"type": "string", "pattern": "^drs-[0-9a-f]{32}$"},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_digest"],
      "properties": {
        "prompt_id": {"type": "string", "pattern": "^dpr-[0-9a-f]{32}$"},
        "prompt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "source": {"$ref": "human-decision-prompt.schema.json#/$defs/source"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "transition"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "transition": {"$ref": "human-decision-prompt.schema.json#/$defs/transition"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "actor_class", "recording_method"],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "actor_class": {"const": "human"},
        "recording_method": {"enum": ["host_single_select", "reference_terminal_single_select"]}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_recorded", "selected_transition_authorized", "decision_applied", "authorizes_code_change", "authorizes_scope_expansion", "authorizes_exception", "authorizes_git_operations", "authorizes_deployment", "authorizes_release"],
      "properties": {
        "decision_recorded": {"const": true},
        "selected_transition_authorized": {"type": "boolean"},
        "decision_applied": {"const": false},
        "authorizes_code_change": {"const": false},
        "authorizes_scope_expansion": {"const": false},
        "authorizes_exception": {"const": false},
        "authorizes_git_operations": {"const": false},
        "authorizes_deployment": {"const": false},
        "authorizes_release": {"const": false}
      }
    }
  }
}
