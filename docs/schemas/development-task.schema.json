{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/development-task-v1.1.json",
  "title": "AgentGov Development Task",
  "description": "A human-declared, repository-native contract that bounds one coding-agent development task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "profile",
    "task_id",
    "title",
    "requirement",
    "scope",
    "acceptance_signals",
    "validation_commands",
    "owner",
    "risk",
    "decision"
  ],
  "properties": {
    "contract": {"const": "agentgov.development-task"},
    "schema_version": {"const": "1.1"},
    "profile": {"enum": ["compact", "standard"]},
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 5},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source_refs"],
      "properties": {
        "summary": {"type": "string", "minLength": 10},
        "source_refs": {"$ref": "#/$defs/optionalFileReferences"}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "parent_refs", "rationale"],
      "properties": {
        "role": {"enum": ["core", "supporting", "maintenance"]},
        "parent_refs": {"$ref": "#/$defs/fileReferences"},
        "rationale": {"type": "string", "minLength": 10}
      }
    },
    "goal": {"type": "string", "minLength": 10},
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_paths", "exclude_paths"],
      "properties": {
        "include_paths": {"$ref": "#/$defs/scopePaths"},
        "exclude_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scopePath"}
        }
      }
    },
    "architecture_refs": {"$ref": "#/$defs/optionalFileReferences"},
    "acceptance_signals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "owner": {"type": "string", "minLength": 1},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "items"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "owner", "evidence_refs"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "owner": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/optionalFileReferences"}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": false}}},
          "then": {
            "properties": {
              "status": {"const": "not_required"},
              "evidence_refs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "required": {"const": true},
              "status": {"const": "approved"}
            },
            "required": ["required", "status"]
          },
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decided_by", "rationale"],
      "properties": {
        "state": {"enum": ["draft", "admitted", "paused"]},
        "decided_by": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 10}
      }
    }
  },
  "$defs": {
    "fileReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "optionalFileReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scopePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\*?\\[\\]]).+$"
    },
    "scopePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scopePath"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "standard"}}, "required": ["profile"]},
      "then": {
        "required": [
          "objective",
          "goal",
          "non_goals",
          "architecture_refs",
          "approval",
          "stop_conditions"
        ]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "compact"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "risk": {"properties": {"level": {"const": "low"}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": {
            "properties": {"level": {"enum": ["high", "critical"]}},
            "required": ["level"]
          }
        },
        "required": ["risk"]
      },
      "then": {
        "required": ["approval"],
        "properties": {
          "risk": {"properties": {"items": {"minItems": 1}}},
          "approval": {"properties": {"required": {"const": true}}}
        }
      }
    }
  ]
}
