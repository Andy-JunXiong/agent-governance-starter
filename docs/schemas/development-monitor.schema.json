{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/development-monitor-v1.10.json",
  "title": "AgentGov Development Monitor",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "generated_at", "observation", "active_task", "overview", "live_sessions", "protection_events", "timeline", "tasks", "benefit", "learning", "drift_review", "claim_layers", "authority_boundary"],
  "properties": {
    "contract": {"const": "agentgov.development-monitor"},
    "schema_version": {"const": "1.10"},
    "generated_at": {"type": "string", "minLength": 1},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "source_kind", "source_event_counts", "event_files_read", "duplicates_removed", "event_count", "started_at", "ended_at", "history_completeness", "missing_sources", "cross_stage_discovery_available"],
      "properties": {
        "scope": {"enum": ["local_session", "exported_development", "ci_only", "combined"]},
        "source_kind": {"enum": ["repository_local_event_store", "ci_job_local_events", "redacted_development_export", "combined_sources"]},
        "source_event_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_session", "exported_development", "ci_only"],
          "properties": {
            "local_session": {"$ref": "#/$defs/count"},
            "exported_development": {"$ref": "#/$defs/count"},
            "ci_only": {"$ref": "#/$defs/count"}
          }
        },
        "event_files_read": {"type": "integer", "minimum": 0},
        "duplicates_removed": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "history_completeness": {"enum": ["partial"]},
        "missing_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cross_stage_discovery_available": {"const": false}
      }
    },
    "active_task": {"$ref": "#/$defs/activeTask"},
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "events", "task_starts", "scope_checks", "validations", "completions", "handoffs", "passed_events", "failed_events", "stale_events", "verified_completions", "needs_evidence_completions", "event_reported_failures", "event_reported_advisories", "protection_events", "sessions_needing_attention"],
      "properties": {
        "tasks": {"$ref": "#/$defs/count"},
        "events": {"$ref": "#/$defs/count"},
        "task_starts": {"$ref": "#/$defs/count"},
        "scope_checks": {"$ref": "#/$defs/count"},
        "validations": {"$ref": "#/$defs/count"},
        "completions": {"$ref": "#/$defs/count"},
        "handoffs": {"$ref": "#/$defs/count"},
        "passed_events": {"$ref": "#/$defs/count"},
        "failed_events": {"$ref": "#/$defs/count"},
        "stale_events": {"$ref": "#/$defs/count"},
        "verified_completions": {"$ref": "#/$defs/count"},
        "needs_evidence_completions": {"$ref": "#/$defs/count"},
        "event_reported_failures": {"$ref": "#/$defs/count"},
        "event_reported_advisories": {"$ref": "#/$defs/count"},
        "protection_events": {"$ref": "#/$defs/count"},
        "sessions_needing_attention": {"$ref": "#/$defs/count"}
      }
    },
    "live_sessions": {"type": "array", "items": {"$ref": "#/$defs/liveSession"}},
    "protection_events": {"type": "array", "items": {"$ref": "#/$defs/protectionEvent"}},
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/timelineEvent"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "benefit": {"$ref": "#/$defs/benefitView"},
    "learning": {"$ref": "#/$defs/learningView"},
    "drift_review": {"$ref": "drift-review-status.schema.json"},
    "claim_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "inferred", "unknown"],
      "properties": {
        "observed": {"$ref": "#/$defs/claims"},
        "inferred": {"$ref": "#/$defs/claims"},
        "unknown": {"$ref": "#/$defs/claims"}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approves_governance", "writes_governance_files", "authorizes_exception", "authorizes_commit", "authorizes_merge", "authorizes_deployment"],
      "properties": {
        "approves_governance": {"const": false},
        "writes_governance_files": {"const": false},
        "authorizes_exception": {"const": false},
        "authorizes_commit": {"const": false},
        "authorizes_merge": {"const": false},
        "authorizes_deployment": {"const": false}
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\).+$"},
    "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
    "activeTaskAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizes_commit", "authorizes_merge", "authorizes_publish", "authorizes_release", "authorizes_deploy"],
      "properties": {
        "authorizes_commit": {"const": false},
        "authorizes_merge": {"const": false},
        "authorizes_publish": {"const": false},
        "authorizes_release": {"const": false},
        "authorizes_deploy": {"const": false}
      }
    },
    "activeTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "reason_code", "claim_limits", "authority"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "identity": {"$ref": "#/$defs/activeTaskIdentity"},
        "context": {"$ref": "#/$defs/activeTaskContext"},
        "governance_state": {"$ref": "#/$defs/activeTaskState"},
        "evidence": {"$ref": "#/$defs/activeTaskEvidence"},
        "activity_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"}},
        "human_boundary": {"$ref": "#/$defs/activeTaskHumanBoundary"},
        "claim_limits": {"$ref": "#/$defs/claims"},
        "authority": {"$ref": "#/$defs/activeTaskAuthority"}
      },
      "oneOf": [
        {
          "properties": {"availability": {"const": "unavailable"}},
          "not": {"anyOf": [
            {"required": ["identity"]}, {"required": ["context"]}, {"required": ["governance_state"]},
            {"required": ["evidence"]}, {"required": ["activity_event_ids"]}, {"required": ["human_boundary"]}
          ]}
        },
        {
          "properties": {"availability": {"const": "available"}, "reason_code": {"const": "active_task_bound"}},
          "required": ["identity", "context", "governance_state", "evidence", "activity_event_ids", "human_boundary"]
        }
      ]
    },
    "activeTaskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_digest", "task_path", "title", "profile", "decision_state"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "task_path": {"$ref": "#/$defs/path"},
        "title": {"type": "string", "minLength": 1},
        "profile": {"enum": ["compact", "standard"]},
        "decision_state": {"const": "admitted"}
      }
    },
    "activeTaskContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_summary", "goal", "non_goals", "include_paths", "exclude_paths", "architecture_refs", "acceptance_signals"],
      "properties": {
        "requirement_summary": {"type": "string", "minLength": 1},
        "goal": {"type": ["string", "null"]},
        "non_goals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "include_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "exclude_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "architecture_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "acceptance_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "activeTaskState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "task_id", "task_digest", "stage", "recommended_operation", "blocking", "reason_code", "event_count", "latest_event_type", "latest_outcome", "authority_boundary", "human_meaning"],
      "properties": {
        "contract": {"const": "agentgov.development-state"},
        "schema_version": {"const": "1.0"},
        "task_id": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "stage": {"enum": ["active_unchecked", "scope_passed", "scope_blocked", "validation_recorded", "needs_evidence", "review_ready", "handed_off", "invalid"]},
        "recommended_operation": {"enum": ["check_scope", "validate_and_reconcile", "reconcile_completion", "refresh_dashboard", "rollover", "require_human"]},
        "blocking": {"type": "boolean"},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "event_count": {"$ref": "#/$defs/count"},
        "latest_event_type": {"enum": ["task.started", "scope.checked", "validation.completed", "completion.reconciled", "session.handed_off", null]},
        "latest_outcome": {"enum": ["started", "passed", "failed", "stale", "needs_evidence", "verified", "handed_off", null]},
        "authority_boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["executes_operation", "authorizes_code_change", "authorizes_exception", "authorizes_commit", "authorizes_merge", "authorizes_deployment"],
          "properties": {
            "executes_operation": {"const": false}, "authorizes_code_change": {"const": false},
            "authorizes_exception": {"const": false}, "authorizes_commit": {"const": false},
            "authorizes_merge": {"const": false}, "authorizes_deployment": {"const": false}
          }
        },
        "human_meaning": {"type": "string", "minLength": 1}
      }
    },
    "activeTaskHumanBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "title", "guidance", "decision_applied"],
      "properties": {
        "availability": {"const": "read_only_guidance"},
        "title": {"type": "string", "minLength": 1},
        "guidance": {"type": "string", "minLength": 1},
        "decision_applied": {"const": false}
      }
    },
    "activeTaskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "validation", "completion"],
      "properties": {
        "scope": {"$ref": "#/$defs/activeScopeEvidence"},
        "validation": {"$ref": "#/$defs/activeEventEvidence"},
        "completion": {"$ref": "#/$defs/activeEventEvidence"}
      }
    },
    "activeEventEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
        "outcome": {"enum": ["passed", "failed", "stale", "needs_evidence", "verified"]},
        "evidence_ref": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "metrics": {"$ref": "#/$defs/metrics"}
      },
      "oneOf": [
        {"properties": {"availability": {"const": "unavailable"}}, "required": ["reason_code"]},
        {"properties": {"availability": {"const": "available"}}, "required": ["event_id", "outcome", "evidence_ref", "metrics"]}
      ]
    },
    "activeScopeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
        "outcome": {"enum": ["passed", "failed"]},
        "evidence_ref": {"$ref": "#/$defs/path"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "affected_paths": {"type": "array", "items": {"$ref": "#/$defs/activeAffectedPath"}},
        "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activeScopeFinding"}},
        "known_limits": {"$ref": "#/$defs/claims"}
      },
      "oneOf": [
        {"properties": {"availability": {"const": "unavailable"}}, "required": ["reason_code"]},
        {"properties": {"availability": {"const": "available"}}, "required": ["event_id", "outcome", "evidence_ref", "head_sha", "affected_paths", "findings", "known_limits"]}
      ]
    },
    "activeAffectedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "layer", "change_status", "status", "admitted", "matched_include", "matched_exclude", "reason"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "role": {"enum": ["current", "old", "new"]},
        "layer": {"enum": ["staged", "unstaged", "untracked"]},
        "change_status": {"enum": ["added", "copied", "deleted", "modified", "renamed", "type_changed", "unmerged", "unknown", "untracked"]},
        "status": {"enum": ["PASS", "FAIL"]}, "admitted": {"type": "boolean"},
        "matched_include": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "matched_exclude": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "activeScopeFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "check_id", "message"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "ADVISORY"]},
        "check_id": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "occurred_at", "event_type", "source_scope", "actor_class", "actor_label", "task_id", "task_digest", "outcome", "governance_refs", "reason_codes", "evidence_ref", "metrics"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
        "occurred_at": {"type": "string", "minLength": 1},
        "event_type": {"enum": ["task.started", "scope.checked", "validation.completed", "completion.reconciled", "session.handed_off"]},
        "source_scope": {"enum": ["local_session", "exported_development", "ci_only"]},
        "actor_class": {"enum": ["human", "coding_agent", "ci"]},
        "actor_label": {"type": ["string", "null"]},
        "task_id": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["started", "passed", "failed", "stale", "needs_evidence", "verified", "handed_off"]},
        "governance_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "evidence_ref": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "liveSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_digest", "state", "attention_required", "latest_event_type", "latest_recorded_outcome", "last_observed_at"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["active", "needs_attention", "review_ready", "handed_off"]},
        "attention_required": {"type": "boolean"},
        "latest_event_type": {"enum": ["task.started", "scope.checked", "validation.completed", "completion.reconciled", "session.handed_off"]},
        "latest_recorded_outcome": {"enum": ["started", "passed", "failed", "stale", "needs_evidence", "verified", "handed_off"]},
        "last_observed_at": {"type": "string", "minLength": 1}
      }
    },
    "protectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protection_id", "source_event_id", "source_scope", "occurred_at", "task_id", "protection_type", "observed_outcome", "status", "guidance", "reason_codes", "evidence_ref"],
      "properties": {
        "protection_id": {"type": "string", "pattern": "^protection:evt-[0-9a-f]{32}$"},
        "source_event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
        "source_scope": {"enum": ["local_session", "exported_development", "ci_only"]},
        "occurred_at": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "protection_type": {"enum": ["scope_boundary", "validation_failure", "stale_evidence", "incomplete_completion"]},
        "observed_outcome": {"enum": ["failed", "stale", "needs_evidence"]},
        "status": {"const": "observed_resolution_unknown"},
        "guidance": {"$ref": "#/$defs/protectionGuidance"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "evidence_ref": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}
      }
    },
    "protectionGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "action_id", "label", "target", "semantics"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "action_id": {
          "enum": ["review_scope_boundary", "review_validation_failure", "refresh_stale_evidence", "complete_missing_evidence", null]
        },
        "label": {"type": "string", "minLength": 1},
        "target": {"enum": ["task_detail", null]},
        "semantics": {"const": "read_only_navigation"}
      },
      "oneOf": [
        {
          "properties": {
            "availability": {"const": "available"},
            "action_id": {"enum": ["review_scope_boundary", "review_validation_failure", "refresh_stale_evidence", "complete_missing_evidence"]},
            "target": {"const": "task_detail"}
          }
        },
        {
          "properties": {
            "availability": {"const": "unavailable"},
            "action_id": {"type": "null"},
            "label": {"const": "Resolution guidance unavailable"},
            "target": {"type": "null"}
          }
        }
      ]
    },
    "benefitView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_mode", "scope", "observation_window", "cards", "claim_limit"],
      "properties": {
        "comparison_mode": {"const": "single_observation_only"},
        "scope": {"enum": ["local_session", "exported_development", "ci_only", "combined"]},
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "ended_at"],
          "properties": {
            "started_at": {"type": ["string", "null"]},
            "ended_at": {"type": ["string", "null"]}
          }
        },
        "cards": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/benefitCard"}
        },
        "claim_limit": {"const": "Single-observation cards do not prove causal benefit, prevention, time savings, governance completeness, or return on investment."}
      }
    },
    "benefitCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "claim_class", "status", "semantics", "title", "summary", "reason_codes", "metrics"],
      "properties": {
        "card_id": {"enum": ["current_scope_activity", "cross_window_comparison", "review_prioritization", "attributed_human_feedback", "causal_benefit_limits"]},
        "claim_class": {"enum": ["observed_fact", "reproduced_comparison", "supported_inference", "human_feedback", "unknown"]},
        "status": {"enum": ["observed", "supported", "unavailable", "unknown"]},
        "semantics": {"enum": ["observed", "advisory", "human_judgment", "unknown"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "metrics": {"$ref": "#/$defs/metrics"}
      },
      "oneOf": [
        {
          "properties": {
            "card_id": {"const": "current_scope_activity"},
            "claim_class": {"const": "observed_fact"},
            "status": {"const": "observed"},
            "semantics": {"const": "observed"}
          }
        },
        {
          "properties": {
            "card_id": {"const": "cross_window_comparison"},
            "claim_class": {"const": "reproduced_comparison"},
            "status": {"const": "unavailable"},
            "semantics": {"const": "observed"},
            "metrics": {"maxProperties": 0}
          }
        },
        {
          "properties": {
            "card_id": {"const": "review_prioritization"},
            "claim_class": {"const": "supported_inference"},
            "status": {"enum": ["supported", "unavailable"]},
            "semantics": {"const": "advisory"}
          }
        },
        {
          "properties": {
            "card_id": {"const": "attributed_human_feedback"},
            "claim_class": {"const": "human_feedback"},
            "status": {"const": "unavailable"},
            "semantics": {"const": "human_judgment"},
            "metrics": {"maxProperties": 0}
          }
        },
        {
          "properties": {
            "card_id": {"const": "causal_benefit_limits"},
            "claim_class": {"const": "unknown"},
            "status": {"const": "unknown"},
            "semantics": {"const": "unknown"},
            "metrics": {"maxProperties": 0}
          }
        }
      ]
    },
    "learningView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scope", "observation_window", "recurrence_rule", "human_review_source", "cards", "claim_limit"],
      "properties": {
        "mode": {"const": "current_observation_candidates"},
        "scope": {"enum": ["local_session", "exported_development", "ci_only", "combined"]},
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "ended_at"],
          "properties": {
            "started_at": {"type": ["string", "null"]},
            "ended_at": {"type": ["string", "null"]}
          }
        },
        "recurrence_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal_source", "minimum_occurrences", "requires_distinct_tasks", "generalization_allowed"],
          "properties": {
            "signal_source": {"const": "protection_type"},
            "minimum_occurrences": {"const": 2},
            "requires_distinct_tasks": {"const": false},
            "generalization_allowed": {"const": false}
          }
        },
        "human_review_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "source_kind", "records_read", "matched_records", "stale_records"],
          "properties": {
            "availability": {"enum": ["available", "unavailable"]},
            "source_kind": {"enum": ["repository_local_learning_reviews", "absent_from_selected_event_source"]},
            "records_read": {"$ref": "#/$defs/count"},
            "matched_records": {"$ref": "#/$defs/count"},
            "stale_records": {"$ref": "#/$defs/count"}
          }
        },
        "cards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/learningCard"}
        },
        "claim_limit": {"const": "Current-observation repetition does not prove shared root cause, false-positive status, systemic weakness, improvement, transferability, future recurrence, or causal benefit."}
      }
    },
    "learningCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "candidate_digest", "occurrences", "distinct_tasks", "cross_task"],
      "properties": {
        "signal_id": {"enum": ["scope_boundary", "validation_failure", "stale_evidence", "incomplete_completion"]},
        "candidate_digest": {"$ref": "#/$defs/sha256"},
        "occurrences": {"type": "integer", "minimum": 2},
        "distinct_tasks": {"type": "integer", "minimum": 1},
        "cross_task": {"type": "boolean"}
      }
    },
    "learningJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "disposition", "recorded_at", "actor_role", "semantics", "resolution", "reason_codes"],
      "properties": {
        "signal_id": {"enum": ["scope_boundary", "validation_failure", "stale_evidence", "incomplete_completion"]},
        "disposition": {"enum": ["confirmed_constraint_gap", "false_positive", "intentional_override", "consumer_configuration_needed", "improvement_candidate", "no_change_needed"]},
        "recorded_at": {"type": "string", "minLength": 1},
        "actor_role": {"const": "human_product_owner"},
        "semantics": {"const": "human_judgment"},
        "resolution": {"const": "unknown"},
        "reason_codes": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "learningCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "learning_class", "status", "semantics", "title", "summary", "reason_codes", "metrics", "candidates", "judgments", "topics"],
      "properties": {
        "card_id": {"enum": ["observed_protection_signals", "repeated_protection_signals", "human_learning_judgments", "learning_limits"]},
        "learning_class": {"enum": ["observed_signal", "repeated_signal_candidate", "human_judgment", "unknown"]},
        "status": {"enum": ["observed", "candidates_observed", "none_observed", "unavailable", "recorded", "unknown"]},
        "semantics": {"enum": ["observed", "advisory", "human_judgment", "unknown"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "candidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/learningCandidate"}},
        "judgments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/learningJudgment"}},
        "topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["false_positive_disposition", "missed_constraint_confirmation", "override_outcome", "consumer_local_configuration_need", "general_improvement_decision", "causal_improvement", "outside_scope_applicability", "transferability", "future_recurrence", "time_savings", "governance_completeness", "return_on_investment"]}
        }
      },
      "oneOf": [
        {
          "properties": {
            "card_id": {"const": "observed_protection_signals"},
            "learning_class": {"const": "observed_signal"},
            "status": {"const": "observed"},
            "semantics": {"const": "observed"},
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope_boundary", "validation_failure", "stale_evidence", "incomplete_completion"],
              "properties": {
                "scope_boundary": {"$ref": "#/$defs/count"},
                "validation_failure": {"$ref": "#/$defs/count"},
                "stale_evidence": {"$ref": "#/$defs/count"},
                "incomplete_completion": {"$ref": "#/$defs/count"}
              }
            },
            "candidates": {"maxItems": 0},
            "judgments": {"maxItems": 0},
            "topics": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "card_id": {"const": "repeated_protection_signals"},
            "learning_class": {"const": "repeated_signal_candidate"},
            "status": {"enum": ["candidates_observed", "none_observed"]},
            "semantics": {"const": "advisory"},
            "metrics": {"maxProperties": 0},
            "judgments": {"maxItems": 0},
            "topics": {"maxItems": 0}
          },
          "oneOf": [
            {"properties": {"status": {"const": "candidates_observed"}, "candidates": {"minItems": 1}}},
            {"properties": {"status": {"const": "none_observed"}, "candidates": {"maxItems": 0}}}
          ]
        },
        {
          "properties": {
            "card_id": {"const": "human_learning_judgments"},
            "learning_class": {"const": "human_judgment"},
            "semantics": {"const": "human_judgment"},
            "candidates": {"maxItems": 0},
            "topics": {"const": ["false_positive_disposition", "missed_constraint_confirmation", "override_outcome", "consumer_local_configuration_need", "general_improvement_decision"]}
          },
          "oneOf": [
            {
              "properties": {
                "status": {"const": "unavailable"},
                "metrics": {"maxProperties": 0},
                "judgments": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "status": {"const": "recorded"},
                "metrics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["matched_reviews", "confirmed_constraint_gap", "false_positive", "intentional_override", "consumer_configuration_needed", "improvement_candidate", "no_change_needed"],
                  "properties": {
                    "matched_reviews": {"type": "integer", "minimum": 1},
                    "confirmed_constraint_gap": {"$ref": "#/$defs/count"},
                    "false_positive": {"$ref": "#/$defs/count"},
                    "intentional_override": {"$ref": "#/$defs/count"},
                    "consumer_configuration_needed": {"$ref": "#/$defs/count"},
                    "improvement_candidate": {"$ref": "#/$defs/count"},
                    "no_change_needed": {"$ref": "#/$defs/count"}
                  }
                },
                "judgments": {"minItems": 1}
              }
            }
          ]
        },
        {
          "properties": {
            "card_id": {"const": "learning_limits"},
            "learning_class": {"const": "unknown"},
            "status": {"const": "unknown"},
            "semantics": {"const": "unknown"},
            "metrics": {"maxProperties": 0},
            "candidates": {"maxItems": 0},
            "judgments": {"maxItems": 0},
            "topics": {"const": ["causal_improvement", "outside_scope_applicability", "transferability", "future_recurrence", "time_savings", "governance_completeness", "return_on_investment"]}
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_digests", "event_count", "first_observed_at", "last_observed_at", "task_starts", "scope_checks", "validations", "completions", "handoffs", "latest_event_type", "latest_recorded_outcome", "latest_completion_state", "latest_completion_at", "latest_routing_state", "latest_handoff_at", "observed_failure_count", "observed_advisory_count", "events"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "event_count": {"$ref": "#/$defs/count"},
        "first_observed_at": {"type": "string", "minLength": 1},
        "last_observed_at": {"type": "string", "minLength": 1},
        "task_starts": {"$ref": "#/$defs/count"},
        "scope_checks": {"$ref": "#/$defs/count"},
        "validations": {"$ref": "#/$defs/count"},
        "completions": {"$ref": "#/$defs/count"},
        "handoffs": {"$ref": "#/$defs/count"},
        "latest_event_type": {"enum": ["task.started", "scope.checked", "validation.completed", "completion.reconciled", "session.handed_off"]},
        "latest_recorded_outcome": {"enum": ["started", "passed", "failed", "stale", "needs_evidence", "verified", "handed_off"]},
        "latest_completion_state": {"enum": ["needs_evidence", "verified", null]},
        "latest_completion_at": {"type": ["string", "null"]},
        "latest_routing_state": {"enum": ["active", "handed_off"]},
        "latest_handoff_at": {"type": ["string", "null"]},
        "observed_failure_count": {"$ref": "#/$defs/count"},
        "observed_advisory_count": {"$ref": "#/$defs/count"},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timelineEvent"}}
      }
    }
  }
}
